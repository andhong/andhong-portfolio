---
// "Using AI to make tutors more effective": the four AI features as a bento grid,
// each tile a short looping video. Every video was exported on the same warm gray
// (#f5f0ed), so the tiles use that exact color and the video edges disappear.
//
// Four in a row, text above each video. Every video sits in a box of the same shape
// and is scaled to fit (never cropped), so each one's UI is centered in its box and
// the boxes line up along the bottom. Tablets: 2 x 2. Phones: one column.

const tiles = [
  {
    key: 'lessons',
    title: 'Lesson plans',
    text: 'Generate a plan for the next class, refine it in plain words, then turn it into slides.',
    video: '/media/ai-lesson-plans-v2.mp4',
    w: 1120,
    h: 1460,
  },
  {
    key: 'recaps',
    title: 'Class recaps',
    text: 'A recap is drafted after every class. Tutors review, edit, and share it with families.',
    video: '/media/ai-class-recaps-v2.mp4',
    w: 960,
    h: 880,
  },
  {
    key: 'assistant',
    title: 'Teaching assistant',
    text: 'Real-time tips in the classroom while class is happening.',
    video: '/media/ai-teaching-assistant-v2.mp4',
    w: 960,
    h: 1000,
  },
  {
    key: 'clips',
    title: 'Tutor Clips',
    text: 'Key moments from class, ready for families to watch and share.',
    video: '/media/ai-tutor-clips.mp4',
    w: 1280,
    h: 1060,
  },
];
---

<div class="ai-bento wide" role="group" aria-label="AI features for tutors">
  {
    tiles.map((t) => (
      <div class={`tile ${t.key}`}>
        <div class="copy">
          <h3>{t.title}</h3>
          <p>{t.text}</p>
        </div>
        <video
          src={t.video}
          poster={t.video.replace('.mp4', '-poster.jpg')}
          width={t.w}
          height={t.h}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={`${t.title}: ${t.text}`}
        />
      </div>
    ))
  }
</div>

<style>
  .ai-bento {
    --tile: #f6f1ee; /* what browsers render the videos’ #f5f0ed as */
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: clamp(60px, 8vw, 100px);
  }
  .tile {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--tile);
    border-radius: 10px;
  }
  .copy {
    padding: 22px 20px 0;
  }
  h3 {
    margin: 0 0 6px;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .copy p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.4;
    color: var(--muted);
  }
  /* Same box for every video, pinned to the bottom of the tile; the video is scaled to
     fit and centered, so its UI sits in the middle. The empty edges match the tile. */
  video {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    height: auto;
    margin-top: auto;
    object-fit: contain;
    object-position: center;
    background: var(--tile);
  }
  @media (max-width: 900px) {
    .ai-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .ai-bento {
      grid-template-columns: 1fr;
    }
  }
</style>
