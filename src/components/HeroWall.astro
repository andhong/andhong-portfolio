---
// Dojo Tutor hero: a tilted wall of real screens whose columns drift slowly and
// endlessly, alternating up and down. Replaces the flat dojo-tutor-hero image.
//
// Sizes are in "layer units" (--u): the frame shows VIEW units across, so every
// measurement below scales with the frame's width.
import { getImage } from 'astro:assets';
import { media } from '../lib/media';

interface Props {
  alt: string;
  eager?: boolean;
}
const { alt, eager = false } = Astro.props;

type Tile = string | [string, string]; // desktop screen, or a pair of phone screens
const COLUMNS: Tile[][] = [
  ['notifications', 'pricing-setup', 'insights', ['app-login', 'app-error'], 'chats', 'calendar-day'],
  ['subscriptions', 'chats', ['app-classes', 'app-chat'], 'class-prices', 'pricing-modal', 'parent-home'],
  ['calendar-week', 'calendar-day', 'pricing-earnings', 'group-class-detail', ['app-week', 'app-chatlist'], 'subscriptions'],
  ['pricing-modal', ['app-menu', 'app-substitute'], 'parent-home', 'group-classes', 'insights', 'calendar-week'],
  ['insights', ['app-week', 'app-chatlist'], 'pricing-setup', 'calendar-week', 'notifications', 'class-prices'],
];
// Vertical stagger (layer units) and seconds per loop; odd columns run downward.
const OFFSETS = [-260, -620, -60, -480, -180];
const DURATIONS = [150, 175, 160, 185, 165];

const names = [...new Set(COLUMNS.flat(2))];
// Each screen in a few widths; the browser picks the smallest that's sharp on the
// viewer's screen (a desktop tile is 720/VIEW of the frame width, about 31% of it).
// Phone screenshots are only 390px wide at the source, so they ship at full size.
const DESK_WIDTHS = [760, 1100, 1440];
const shots = Object.fromEntries(
  await Promise.all(
    names.map(async (n) => {
      const src = media(`wall-${n}`);
      if (n.startsWith('app-')) {
        const img = await getImage({ src, width: src.width, format: 'webp', quality: 85 });
        return [n, { src: img.src, srcset: undefined }];
      }
      const imgs = await Promise.all(
        DESK_WIDTHS.filter((w) => w <= src.width).map((w) => getImage({ src, width: w, format: 'webp', quality: 85 })),
      );
      return [n, { src: imgs[0].src, srcset: imgs.map((im, i) => `${im.src} ${DESK_WIDTHS[i]}w`).join(', ') }];
    }),
  ),
);
// Twice the tile's on-screen width: the wall is rotated and always moving, and that
// resampling softens an image that's only just big enough. The files stay small
// (a 1440px screen is ~40 KB), so the extra sharpness is cheap.
const deskSizes = '(max-width: 1202px) 62vw, 732px';
---

<div class="hero-wall" role="img" aria-label={alt}>
  <div class="layer" aria-hidden="true">
    {
      COLUMNS.map((col, c) => (
        <div class="col" style={`--off:${OFFSETS[c]};--dur:${DURATIONS[c]}s;--dir:${c % 2 ? 'reverse' : 'normal'}`}>
          <div class="track">
            {[...col, ...col].map((t) =>
              Array.isArray(t) ? (
                <div class="pair">
                  <img class="phone" src={shots[t[0]].src} alt="" width="300" height="649" loading={eager ? 'eager' : 'lazy'} decoding="async" />
                  <img class="phone" src={shots[t[1]].src} alt="" width="300" height="649" loading={eager ? 'eager' : 'lazy'} decoding="async" />
                </div>
              ) : (
                <img class="desk" src={shots[t].src} srcset={shots[t].srcset} sizes={deskSizes} alt="" width="720" height="512" loading={eager ? 'eager' : 'lazy'} decoding="async" />
              ),
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .hero-wall {
    /* VIEW: layer units visible across the frame. Smaller = more zoomed in. */
    --view: 2300;
    --gap: 36;
    --angle: -18deg;
    --shift: 300; /* moves the wall up so it fills the top of the frame */
    container-type: inline-size;
    position: relative;
    width: 100%;
    aspect-ratio: 1840 / 1300;
    overflow: hidden;
    border-radius: var(--radius);
    background: #fdf6ee;
  }
  .layer {
    --u: calc(100cqw / var(--view));
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    gap: calc(var(--gap) * var(--u));
    height: calc(2700 * var(--u));
    transform: translate(-50%, -50%) translateY(calc(var(--shift) * var(--u) * -1)) rotate(var(--angle));
  }
  .col {
    width: calc(720 * var(--u));
    flex: none;
  }
  .track {
    display: flex;
    flex-direction: column;
    gap: calc(var(--gap) * var(--u));
    margin-top: calc(var(--off) * var(--u));
    animation: wall-drift var(--dur) linear infinite;
    animation-direction: var(--dir);
    will-change: transform;
  }
  /* The track holds the column twice; moving it by one copy (plus the gap between
     copies) lands exactly where it started, so the loop is seamless. */
  @keyframes wall-drift {
    to {
      transform: translateY(calc(-50% - var(--gap) * var(--u) / 2));
    }
  }
  .hero-wall img {
    display: block;
    max-width: none;
    height: auto;
    background: #fff;
    box-shadow:
      0 0 0 calc(1.5 * var(--u)) rgba(60, 45, 10, 0.12),
      0 calc(16 * var(--u)) calc(40 * var(--u)) rgba(110, 92, 74, 0.28);
  }
  .hero-wall .desk {
    width: 100%;
  }
  .pair {
    display: flex;
    justify-content: center;
    gap: calc(var(--gap) * var(--u));
  }
  /* Phone screenshots have transparent rounded corners in the files themselves
     (cut just past the black iOS display corners), so the shadow is a drop-shadow
     that follows that shape. A hairline edge keeps white screens off the cream. */
  .hero-wall .phone {
    width: calc(300 * var(--u));
    background: none;
    box-shadow: none;
    filter: drop-shadow(0 0 calc(0.75 * var(--u)) rgba(60, 45, 10, 0.45))
      drop-shadow(0 calc(18 * var(--u)) calc(22 * var(--u)) rgba(110, 92, 74, 0.38));
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
