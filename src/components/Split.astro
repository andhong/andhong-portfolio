---
import Pic from './Pic.astro';

interface Props {
  name: string;
  alt: string;
  heading: string;
}

const { name, alt, heading } = Astro.props;
---

<section class="split">
  <Pic name={name} alt={alt} sizes="(max-width: 800px) 100vw, 400px" />
  <div class="text">
    <h3>{heading}</h3>
    <slot />
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
    margin-bottom: clamp(60px, 8vw, 100px);
  }
  .split :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }
  h3 {
    margin-bottom: 20px;
  }
  .text {
    font-size: calc(var(--text) * 0.95);
  }
  @media (max-width: 800px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
