---
import Pic from './Pic.astro';
import Placeholder from './Placeholder.astro';

/** Omit `name` to show a placeholder box (with `ratio`, width / height) until the image exists. */
type Item = { name?: string; alt: string; ratio?: number };

interface Props {
  /** One or more images; several are laid out side by side. */
  images: Item[];
  /** Bold first sentence of the caption; the slot holds the rest. */
  lead?: string;
  eager?: boolean;
  /** Small gap below, for images stacked as one group. */
  tight?: boolean;
}

const { images, lead, eager = false, tight = false } = Astro.props;
const cols = images.length;
const sizes = cols > 1 ? `(max-width: 700px) 100vw, ${Math.round(800 / cols)}px` : undefined;
const hasCaption = lead || Astro.slots.has('default');
---

<figure class:list={['figure', { tight }]}>
  <div class="grid" style={`--cols: ${cols}`}>
    {
      images.map((img, i) =>
        img.name ? (
          <Pic name={img.name} alt={img.alt} sizes={sizes} eager={eager && i === 0} />
        ) : (
          <Placeholder label={img.alt} ratio={img.ratio} />
        ),
      )
    }
  </div>
  {
    hasCaption && (
      <figcaption>
        {lead && <strong>{lead}</strong>}{' '}<span class="muted"><slot /></span>
      </figcaption>
    )
  }
</figure>
