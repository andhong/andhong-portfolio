---
// Phone-only menu: a small square button that grows into a panel from its corner.
// Hidden on wider screens, where the inline nav in the header is shown instead.
import { site, nav } from '../data/site';

interface Props {
  isActive: (href: string) => boolean;
}

const { isActive } = Astro.props;
---

<div class="mm" data-mm>
  <button class="mm-toggle" type="button" aria-expanded="false" aria-controls="mm-panel" aria-label="Open menu">
    <span class="bar" aria-hidden="true"></span>
    <span class="bar" aria-hidden="true"></span>
  </button>

  <div class="mm-backdrop" data-mm-close aria-hidden="true"></div>

  <div class="mm-panel" id="mm-panel" role="dialog" aria-modal="true" aria-label="Menu" inert>
    <p class="label mm-eyebrow">Andrew Hong</p>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item, i) => (
            <li style={`--i: ${i}`}>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
                {isActive(item.href) && <span class="dot" aria-hidden="true" />}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <hr />
    <p class="mm-contact" style={`--i: ${nav.length}`}>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <span aria-hidden="true">·</span>
      <a href={`mailto:${site.email}`}>Email</a>
    </p>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-mm]');
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('.mm-toggle')!;
    const panel = root.querySelector<HTMLElement>('.mm-panel')!;
    const wide = window.matchMedia('(min-width: 641px)');

    const setOpen = (open: boolean, { restoreFocus = true } = {}) => {
      root.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('mm-lock', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.inert = !open;
      if (open) panel.querySelector<HTMLAnchorElement>('nav a')?.focus({ preventScroll: true });
      else if (restoreFocus) toggle.focus({ preventScroll: true });
    };

    toggle.addEventListener('click', () => setOpen(!root.classList.contains('is-open')));
    root.querySelector('[data-mm-close]')!.addEventListener('click', () => setOpen(false));
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false, { restoreFocus: false });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) setOpen(false);
    });
    wide.addEventListener('change', (e) => {
      if (e.matches) setOpen(false, { restoreFocus: false });
    });
    // Coming back via the browser's back button can restore a page with the menu open.
    window.addEventListener('pageshow', () => setOpen(false, { restoreFocus: false }));
  }
</script>

<style>
  .mm {
    display: none;
  }

  @media (max-width: 640px) {
    .mm {
      display: block;
    }
  }

  /* Square button; its two bars cross into an × when open. */
  .mm-toggle {
    position: relative;
    z-index: 30;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--page);
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.3s ease;
  }
  .bar {
    grid-area: 1 / 1;
    width: 17px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.5s cubic-bezier(0.5, 0.5, 0, 1);
  }
  .bar:first-child {
    transform: translateY(-3px);
  }
  .bar:last-child {
    transform: translateY(3px);
  }
  .is-open .mm-toggle {
    border-color: transparent;
  }
  .is-open .bar:first-child {
    transform: rotate(45deg);
  }
  .is-open .bar:last-child {
    transform: rotate(-45deg);
  }

  .mm-backdrop {
    position: fixed;
    inset: 0;
    z-index: 10;
    background: rgba(26, 26, 26, 0.22);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .is-open .mm-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  /* The panel scales up from the button's corner (top right). */
  .mm-panel {
    position: fixed;
    top: 12px;
    right: 12px;
    left: 12px;
    z-index: 20;
    padding: 22px 24px 26px;
    background: var(--page);
    border: 1px solid var(--rule);
    border-radius: 4px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.14);
    transform-origin: calc(100% - 22px) 22px;
    transform: scale(0.1);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 0.6s cubic-bezier(0.5, 0.5, 0, 1),
      opacity 0.3s ease,
      visibility 0s linear 0.6s;
  }
  .is-open .mm-panel {
    transform: scale(1);
    opacity: 1;
    visibility: visible;
    transition:
      transform 0.6s cubic-bezier(0.5, 0.5, 0, 1),
      opacity 0.2s ease,
      visibility 0s;
  }

  .mm-eyebrow {
    margin: 2px 0 40px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li,
  .mm-contact {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.4s ease,
      transform 0.6s cubic-bezier(0.5, 0.5, 0, 1);
  }
  .is-open li,
  .is-open .mm-contact {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.12s + var(--i) * 0.05s);
  }
  nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2px 0;
    font-size: clamp(38px, 11vw, 46px);
    line-height: 1.15;
    letter-spacing: -0.035em;
    text-decoration: none;
    color: var(--ink);
  }
  nav a:not([aria-current='page']) {
    color: var(--muted);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  hr {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 28px 0 18px;
  }
  .mm-contact {
    display: flex;
    gap: 12px;
    margin: 0;
    font-size: var(--text);
  }
  .mm-contact a {
    text-decoration: none;
  }
  .mm-contact span {
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-panel,
    .is-open .mm-panel,
    li,
    .mm-contact,
    .bar,
    .mm-backdrop {
      transition-duration: 0.01s !important;
      transition-delay: 0s !important;
    }
  }
</style>
