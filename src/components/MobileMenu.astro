---
// Phone-only menu: a small-caps "Menu" button that unfolds a plain list of links
// beneath the header, pushing the page down (no overlay). Hidden on wider screens,
// where the inline nav in the header is shown instead.
import { site, nav } from '../data/site';

interface Props {
  isActive: (href: string) => boolean;
}

const { isActive } = Astro.props;
---

<div class="mm" data-mm>
  <button class="mm-toggle" type="button" aria-expanded="false" aria-controls="mm-panel">
    <span class="when-closed">Menu</span>
    <span class="when-open" aria-hidden="true">Close</span>
  </button>

  <div class="mm-panel" id="mm-panel" inert>
    <div class="mm-inner">
      <nav aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="mm-contact">
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <span aria-hidden="true">·</span>
        <a href={`mailto:${site.email}`}>Email</a>
      </p>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-mm]');
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('.mm-toggle')!;
    const panel = root.querySelector<HTMLElement>('.mm-panel')!;
    const wide = window.matchMedia('(min-width: 641px)');

    const setOpen = (open: boolean) => {
      root.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      panel.inert = !open;
    };

    toggle.addEventListener('click', () => setOpen(!root.classList.contains('is-open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    wide.addEventListener('change', (e) => e.matches && setOpen(false));
    // Coming back via the browser's back button can restore a page with the menu open.
    window.addEventListener('pageshow', () => setOpen(false));
  }
</script>

<style>
  .mm {
    display: none;
  }

  /* On phones the button and panel join the header row; the panel wraps onto
     its own full-width line beneath the logo and button. */
  @media (max-width: 640px) {
    .mm {
      display: contents;
    }
  }

  .mm-toggle {
    padding: 6px 0 3px;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .is-open .mm-toggle {
    border-bottom-color: var(--ink);
  }
  .when-open,
  .is-open .when-closed {
    display: none;
  }
  .is-open .when-open {
    display: inline;
  }

  /* Unfolds by animating the row height from 0 to its natural size. */
  .mm-panel {
    flex-basis: 100%;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.35s ease,
      opacity 0.25s ease;
  }
  .is-open .mm-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .mm-inner {
    overflow: hidden;
    min-height: 0;
  }

  ul {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  li {
    border-bottom: 1px solid var(--rule);
  }
  nav a {
    display: block;
    padding: 10px 0;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--muted);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    font-style: italic;
  }
  .mm-contact {
    display: flex;
    gap: 12px;
    margin: 16px 0 6px;
    font-size: var(--text-sm);
  }
  .mm-contact a {
    text-decoration: none;
  }
  .mm-contact span {
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-panel {
      transition: none;
    }
  }
</style>
