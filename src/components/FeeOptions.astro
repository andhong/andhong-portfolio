---
// "Establishing a fee structure": the pricing models we weighed, in plain terms, ending
// with the one we launched. Each card gives the idea in a sentence, what a tutor earns
// on a regular class and on a trial (bars on a shared scale; the tick is what the family
// pays, so a bar past it means Dojo covered the difference; the lighter segment is
// bonus pay), and the tradeoff that decided it. Business detail (take rates, fees) is
// left out on purpose so the page reads without context.

type Pay = { base: number; bonus?: number; note: string };
type Option = {
  eyebrow: string;
  name: string;
  idea: string;
  regular: Pay; // a $30 class in an ongoing subscription
  trial: Pay; // a $5 first class
  tradeoff: string;
  launched?: boolean;
};

const options: Option[] = [
  {
    eyebrow: 'Before',
    name: 'Dojo sets every price',
    idea: 'One price for every class, with cheap trials to bring families in.',
    regular: { base: 15, note: '$15' },
    trial: { base: 7.5, bonus: 7.5, note: '$7.50, or $15 if the family signs up' },
    tradeoff: 'Dojo paid tutors more than families paid for trials, which can’t last once we pay to find families.',
  },
  {
    eyebrow: 'Option 1',
    name: 'Keep generous trials',
    idea: 'Tutors set prices, and Dojo keeps paying trials well.',
    regular: { base: 15, note: '$15' },
    trial: { base: 7.5, bonus: 7.5, note: '$7.50, or $15 if the family signs up' },
    tradeoff: 'Regular classes would carry high fees to pay for the trials.',
  },
  {
    eyebrow: 'Option 2',
    name: 'One simple rate',
    idea: 'Dojo keeps the same share of every class, trials included.',
    regular: { base: 18, note: '$18' },
    trial: { base: 3, note: '$3' },
    tradeoff: 'Fair and easy to explain, but trial pay drops sharply.',
  },
  {
    eyebrow: 'Option 3',
    name: 'Reward results',
    idea: 'Lower base pay, with bonuses when a trial converts and as families stay.',
    regular: { base: 16.7, bonus: 1.3, note: '$16.70, rising to $18' },
    trial: { base: 3.25, bonus: 7, note: '$3.25, or $10.25 if the family signs up' },
    tradeoff: 'Pays for the outcomes we want, but has more rules to explain.',
  },
  {
    eyebrow: 'What we launched',
    name: 'Simple, with a loyalty reward',
    idea: 'The same share on every class, and tutors earn more the longer a family stays.',
    regular: { base: 16.25, bonus: 1.25, note: '$16.25, rising to $17.50' },
    trial: { base: 3.25, note: '$3.25' },
    tradeoff: 'Most of Option 3’s upside, simple enough to explain in one screen.',
    launched: true,
  },
];

// One scale per class type, shared across every option so bars compare directly.
const rows = [
  { key: 'regular', label: 'Regular class', parent: 30, max: 30 },
  { key: 'trial', label: 'Trial class', parent: 5, max: 15 },
] as const;
const pct = (v: number, max: number) => `${((v / max) * 100).toFixed(2)}%`;
---

<figure class="fee-options" aria-labelledby="fee-options-cap">
  <ol class="cards wide">
    {
      options.map((o) => (
        <li class:list={['card', { launched: o.launched }]}>
          <p class="eyebrow">{o.eyebrow}</p>
          <h3 class="name">{o.name}</h3>
          <p class="idea">{o.idea}</p>
          <p class="pay-head">Tutor earns</p>
          <dl class="pay">
            {rows.map((r) => {
              const p = o[r.key];
              return (
                <div class="pay-row">
                  <dt>
                    {r.label} <span class="parent">· family pays ${r.parent}</span>
                  </dt>
                  <dd>
                    <span class="track" aria-hidden="true">
                      <span class="fill" style={`width:${pct(p.base, r.max)}`} />
                      {p.bonus && (
                        <span class="bonus" style={`left:${pct(p.base, r.max)};width:${pct(p.bonus, r.max)}`} />
                      )}
                      <span class="tick" style={`left:${pct(r.parent, r.max)}`} />
                    </span>
                    <span class="value">{p.note}</span>
                  </dd>
                </div>
              );
            })}
          </dl>
          <p class="takeaway">{o.tradeoff}</p>
        </li>
      ))
    }
  </ol>
  <figcaption id="fee-options-cap">
    <strong>The pricing models we weighed.</strong>{' '}<span class="muted"
      >Bars show what a tutor earns per class. The red tick is what the family pays, so a bar past it means Dojo made up
      the difference. The lighter part of a bar is bonus pay.</span
    >
  </figcaption>
</figure>

<style>
  .fee-options {
    --cream: #fdf6ee;
    --line: rgba(26, 26, 26, 0.14);
    margin: 0 0 clamp(60px, 8vw, 100px);
  }
  .cards {
    list-style: none;
    margin-top: 0;
    margin-bottom: 18px;
    padding: clamp(16px, 2.4vw, 28px);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
    background: var(--cream);
    border-radius: var(--radius);
  }
  /* Each card spans six shared rows (eyebrow, name, terms, pay heading, pay, takeaway),
     so the pay rows line up across cards however long each card's terms run. */
  .card {
    display: grid;
    grid-row: span 6;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
    padding: 18px 16px 16px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 15px;
    line-height: 1.35;
  }
  /* The launched structure wears the site's hard-shadow button treatment. */
  .card.launched {
    border: 1.5px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .eyebrow {
    margin: 0 0 4px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .launched .eyebrow {
    color: var(--ink);
  }
  .name {
    margin: 0 0 10px;
    font-size: 21px;
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .idea {
    align-self: start;
    margin: 0 0 16px;
    color: var(--muted);
  }
  .pay-head {
    margin: 0 0 8px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pay {
    margin: 0 0 14px;
  }
  .pay-row + .pay-row {
    margin-top: 10px;
  }
  .pay dt {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .parent {
    white-space: nowrap;
  }
  .pay dd {
    margin: 0;
  }
  .track {
    position: relative;
    display: block;
    height: 8px;
    margin-bottom: 4px;
    background: rgba(26, 26, 26, 0.06);
    border-radius: 4px;
  }
  .fill,
  .bonus {
    position: absolute;
    top: 0;
    bottom: 0;
  }
  .fill {
    left: 0;
    background: var(--ink);
    border-radius: 4px 0 0 4px;
  }
  /* Bonus pay: same hue, lighter, separated from the base by a 2px surface gap. */
  .bonus {
    background: rgba(26, 26, 26, 0.32);
    border-left: 2px solid #fff;
    border-radius: 0 4px 4px 0;
  }
  .tick {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 2px;
    margin-left: -1px;
    background: #c4302b;
  }
  .value {
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  .takeaway {
    margin: 0;
    font-style: italic;
    color: var(--ink);
  }
  @media (max-width: 1100px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .card.launched {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 600px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
