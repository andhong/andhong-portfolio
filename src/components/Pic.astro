---
import { Picture } from 'astro:assets';
import { media } from '../lib/media';

interface Props {
  /** File name in src/assets/media, without extension. */
  name: string;
  alt: string;
  /** CSS sizes hint for the browser; defaults to the full content column. */
  sizes?: string;
  /** Load immediately (use for the first image above the fold). */
  eager?: boolean;
  class?: string;
}

const { name, alt, sizes = '(max-width: 880px) 100vw, 800px', eager = false, class: className } = Astro.props;
const src = media(name);
// AVIF first, WebP for everything else (every current browser reads WebP). No PNG/JPEG
// copies: they tripled the site's size and made GitHub Pages time out while publishing.
const widths = [480, 800, 1200, 1800, 2340].filter((w) => w < src.width).concat(src.width);
---

<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif']}
  fallbackFormat="webp"
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  class={className}
/>
