---
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props {
  /** Page name, shown before the site name in the tab. Omit on the home page. */
  title?: string;
  description?: string;
  /** Absolute or root-relative URL for the social share image. */
  image?: string;
}

const { title, description = site.description, image } = Astro.props;
const fullTitle = title ? `${title} – ${site.title}` : `${site.title} – Portfolio of ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/project') : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="logo" href="/">Andrew Hong</a>
      <nav aria-label="Main">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="links">
        <a href={site.linkedin}>Linkedin</a>{' • '}<a href={site.cv}>My CV</a>{' • '}<a href={`mailto:${site.email}`}
          >Email</a
        >
      </p>
      <p>Made with <span class="heart" aria-label="love">❤</span> in Philadelphia</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-top: 36px;
    padding-bottom: 36px;
  }
  .logo,
  nav a {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    text-decoration: none;
  }
  .logo {
    color: #000;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: clamp(12px, 2vw, 20px);
  }
  nav a {
    color: var(--nav);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: #000;
  }

  .site-footer {
    background: var(--band);
    text-align: center;
    padding: 90px var(--gutter) 110px;
    font-size: 15px;
    margin-top: 120px;
  }
  .site-footer .links a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .site-footer p {
    margin: 0 0 18px;
  }
  .heart {
    color: #d2001f;
  }

  @media (max-width: 520px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding-top: 24px;
      padding-bottom: 24px;
    }
  }
</style>
