---
import '../styles/global.css';
import { site, nav } from '../data/site';
import MobileMenu from '../components/MobileMenu.astro';

interface Props {
  /** Page name, shown before the site name in the tab. Omit on the home page. */
  title?: string;
  description?: string;
  /** Absolute or root-relative URL for the social share image. */
  image?: string;
  /** Keep the page out of search results (e.g. drafts). */
  noindex?: boolean;
}

const { title, description = site.description, image, noindex = false } = Astro.props;
const fullTitle = title ? `${title} – ${site.title}` : `${site.title} – Portfolio of ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/project') || path.startsWith('/dojo-tutor') : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="logo" href="/">Andrew Hong</a>
      <nav class="desktop-nav" aria-label="Main">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <MobileMenu isActive={isActive} />
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="links">
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><span aria-hidden="true">·</span
        ><a href={`mailto:${site.email}`}>Email</a>
      </p>
      <p class="sign">Made with <span class="heart" aria-label="love">❤</span> in Philadelphia</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-top: 34px;
    padding-bottom: 34px;
  }
  .logo {
    font-size: 24px;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }
  .desktop-nav {
    display: flex;
    gap: clamp(16px, 2.4vw, 28px);
  }
  .desktop-nav a {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--nav);
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
  }
  .desktop-nav a:hover {
    color: var(--ink);
  }
  .desktop-nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    text-align: center;
    padding: 72px var(--gutter) 90px;
    margin-top: 140px;
  }
  .links {
    display: flex;
    justify-content: center;
    gap: 12px;
    font-size: var(--text);
    margin: 0 0 10px;
  }
  .links a {
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .links span {
    color: var(--muted);
  }
  .sign {
    font-style: italic;
    color: var(--muted);
    font-size: var(--text-sm);
    margin: 0;
  }
  .heart {
    color: #c4302b;
    font-style: normal;
  }

  /* Phones: the inline links give way to the expanding menu (MobileMenu). */
  @media (max-width: 640px) {
    .site-header {
      align-items: center;
      padding-top: 14px;
      padding-bottom: 14px;
      padding-right: 12px;
    }
    .logo {
      font-size: 22px;
    }
    .desktop-nav {
      display: none;
    }
  }
</style>
