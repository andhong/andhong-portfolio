---
import Base from './Base.astro';
import { media } from '../lib/media';
import { getImage } from 'astro:assets';

interface Props {
  /** Project name, shown in bold at the start of the headline and in the tab title. */
  name: string;
  /** Rest of the headline after the project name. */
  tagline: string;
  /** Tab/page title, if different from `name`. */
  title?: string;
  /** Image used for link previews (file name in src/assets/media). */
  shareImage?: string;
}

const { name, tagline, title = name, shareImage } = Astro.props;
const og = shareImage
  ? (await getImage({ src: media(shareImage), width: 1200, format: 'jpg' })).src
  : undefined;
---

<Base title={title} description={`${name} ${tagline}`} image={og}>
  <article class="wrap case">
    <h1 class="headline"><strong>{name}</strong> {tagline}</h1>
    <div class="meta"><slot name="meta" /></div>
    <slot />
  </article>
</Base>

<style>
  .case {
    padding-top: clamp(24px, 5vw, 60px);
  }
  .headline {
    color: var(--muted);
    max-width: 1100px;
    margin-bottom: 30px;
  }
  .headline strong {
    color: var(--ink);
    font-weight: 500;
  }
  .meta {
    font-size: 15px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .case :global(.meta p) {
    margin: 0 0 6px;
  }
  .case :global(.callout) {
    background: var(--panel);
    border-radius: 8px;
    padding: 14px 18px;
    margin: 28px 0 0;
    font-size: 15px;
  }
  .case :global(.intro) {
    font-size: 16px;
    max-width: 1170px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .case :global(.section-head) {
    margin-bottom: clamp(36px, 5vw, 60px);
  }
  .case :global(.section-head h2) {
    margin-bottom: 18px;
  }
  .case :global(.section-head p) {
    font-size: 16px;
  }
  .case :global(.section-head h3) {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.3px;
    margin: 28px 0 8px;
  }
</style>
