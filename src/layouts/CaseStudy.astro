---
import Base from './Base.astro';
import { media } from '../lib/media';
import { getImage } from 'astro:assets';

interface Props {
  /** Project name, shown in bold at the start of the headline and in the tab title. */
  name: string;
  /** Rest of the headline after the project name. */
  tagline: string;
  /** Tab/page title, if different from `name`. */
  title?: string;
  /** Image used for link previews (file name in src/assets/media). */
  shareImage?: string;
}

const { name, tagline, title = name, shareImage } = Astro.props;
const og = shareImage
  ? (await getImage({ src: media(shareImage), width: 1200, format: 'jpg' })).src
  : undefined;
---

<Base title={title} description={`${name} ${tagline}`} image={og}>
  <article class="wrap case">
    <h1 class="headline"><strong>{name}</strong> {tagline}</h1>
    <div class="meta"><slot name="meta" /></div>
    <slot />
  </article>
</Base>
