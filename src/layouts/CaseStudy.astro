---
import Base from './Base.astro';
import { media } from '../lib/media';
import { getImage } from 'astro:assets';

interface Props {
  /** Project name, shown in bold at the start of the headline and in the tab title. */
  name: string;
  /** Rest of the headline after the project name. */
  tagline: string;
  /** Tab/page title, if different from `name`. */
  title?: string;
  /** Image used for link previews (file name in src/assets/media). */
  shareImage?: string;
  /** Keep the page out of search results (e.g. drafts). */
  noindex?: boolean;
  /** Project details shown as columns under the headline, e.g.
   *  [{ label: 'Platforms', items: ['iOS', 'Web'] }, { label: 'Years', items: ['2020–2024'] }] */
  details?: { label: string; items: string[] }[];
}

const { name, tagline, title = name, shareImage, noindex = false, details = [] } = Astro.props;
const og = shareImage
  ? (await getImage({ src: media(shareImage), width: 1200, format: 'jpg' })).src
  : undefined;
---

<Base title={title} description={`${name} ${tagline}`} image={og} noindex={noindex}>
  <article class="wrap case">
    <h1 class="headline"><strong>{name}</strong> {tagline}</h1>
    <div class="meta">
      {
        details.length > 0 && (
          <dl class="details">
            {details.map((d) => (
              <div>
                <dt class="label">{d.label}</dt>
                {d.items.map((item) => (
                  <dd>{item}</dd>
                ))}
              </div>
            ))}
          </dl>
        )
      }
      <slot name="meta" />
    </div>
    <slot />
  </article>
</Base>
