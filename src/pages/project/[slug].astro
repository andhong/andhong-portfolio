---
// Password-protected case studies (content is encrypted; see scripts/encrypt-protected.mjs).
import Base from '../../layouts/Base.astro';
import Protected from '../../components/Protected.astro';
import { projects } from '../../data/site';

export function getStaticPaths() {
  return projects.filter((p) => p.protected).map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
---

<Base title={project.title} description={`${project.title} — ${project.blurb}`}>
  <article class="wrap case">
    <h1><strong>{project.title}</strong> <span class="muted">{project.blurb}</span></h1>
    <Protected slug={project.slug} />
  </article>
</Base>

<style>
  .case {
    padding-top: clamp(24px, 5vw, 60px);
  }
  h1 {
    margin-bottom: 40px;
  }
  h1 strong {
    font-weight: 500;
  }
</style>
