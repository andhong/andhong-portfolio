---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { getImage } from 'astro:assets';
import { media } from '../lib/media';

// Listed in reading order (used on phones). `col` places each image in the
// same desktop column as the old site's masonry layout.
const list = [
  { name: 'freezer-cocktail-resized', alt: 'Freezer Cocktail bottle and label', col: 0 },
  { name: 'AJH02564-scaled', alt: 'Green mountain ridge under a blue sky', col: 1 },
  { name: 'Untitled-design-3', alt: 'Hand holding a small printed thank-you card', col: 2 },
  { name: '48940013-scaled', alt: 'Glacier and snowy peaks at the water’s edge', col: 0 },
  { name: 'AJH03002', alt: 'Inflatable pool floats on the grass beside a lake', col: 2 },
  { name: 'wee-heavy-mockup-wide', alt: 'Illustrated beer bottle label on a blue background', col: 1 },
  { name: 'AJH01003-scaled', alt: 'Snow-covered road through the mountains', col: 1 },
  { name: '348624525_3092175547592878_6573827047360235283_n', alt: 'Red umbrella against concrete architecture', col: 2 },
  { name: 'Artboard-12', alt: 'Series of illustrated bottle labels', col: 0 },
  { name: '61730065-rotated', alt: 'Hands on a steering wheel, shot on film', col: 1 },
  { name: 'globe-sm', alt: 'Abstract striped globe illustration', col: 0 },
  { name: 'cp-chelsea', alt: 'Pixel-art Chelsea boot', col: 2 },
  { name: 'once-in-a-blue-moon', alt: 'Two overlapping circles on a teal poster', col: 0 },
];

// Each image also gets a large version for the lightbox (loaded only when opened).
const items = await Promise.all(
  list.map(async (it, order) => {
    const src = media(it.name);
    const full = await getImage({ src, width: Math.min(2000, src.width), format: 'webp', quality: 82 });
    return { ...it, order, full: full.src };
  }),
);

const columns = [0, 1, 2].map((c) => items.filter((it) => it.col === c));
---

<Base title="Play" description="Side projects and other creative pursuits.">
  <section class="wrap full">
    <h1>Side projects and other creative pursuits</h1>
    <div class="masonry">
      {
        columns.map((col) => (
          <div class="col">
            {col.map((it) => (
              <div class="item" style={`order: ${it.order}`}>
                <button
                  class="lb-trigger"
                  type="button"
                  data-full={it.full}
                  data-alt={it.alt}
                  aria-label={`View larger: ${it.alt}`}
                  aria-haspopup="dialog"
                >
                  <Pic name={it.name} alt={it.alt} sizes="(max-width: 700px) 100vw, 380px" eager={it.order < 3} />
                </button>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <dialog class="lightbox" aria-label="Image viewer">
    <button class="lb-close" type="button">Close</button>
    <figure>
      <img alt="" decoding="async" />
    </figure>
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  if (dialog) {
    const img = dialog.querySelector('img')!;

    const close = () => dialog.close();

    for (const trigger of document.querySelectorAll<HTMLButtonElement>('.lb-trigger')) {
      trigger.addEventListener('click', () => {
        img.src = trigger.dataset.full!;
        img.alt = trigger.dataset.alt!;
        document.documentElement.classList.add('lb-lock');
        dialog.showModal(); // focus returns to the trigger automatically on close
      });
    }

    dialog.querySelector('.lb-close')!.addEventListener('click', close);
    // Clicking anywhere except the image itself (or the close button) dismisses.
    dialog.addEventListener('click', (e) => {
      if (e.target !== img) close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lb-lock');
      img.removeAttribute('src');
    });
  }
</script>

<style>
  h1 {
    text-align: center;
    font-size: clamp(30px, 3.4vw, 40px);
    padding: clamp(30px, 6vw, 70px) 0 clamp(50px, 6vw, 80px);
  }
  .masonry {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .lb-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .lb-trigger:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 4px;
  }
  .item :global(img) {
    width: 100%;
    border-radius: var(--radius);
    transition: opacity 0.3s ease;
  }
  .lb-trigger:hover :global(img) {
    opacity: 0.9;
  }
  @media (max-width: 700px) {
    .masonry {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .col {
      display: contents;
    }
  }

  /* Lightbox */
  :global(html.lb-lock) {
    overflow: hidden;
  }
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-out;
  }
  .lightbox::backdrop {
    background: rgba(255, 255, 255, 0.985);
  }
  .lightbox[open],
  .lightbox[open]::backdrop {
    animation: lb-fade 0.2s ease;
  }
  @keyframes lb-fade {
    from {
      opacity: 0;
    }
  }
  .lightbox figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    margin: 0;
    padding: 64px var(--gutter);
  }
  .lightbox img {
    max-width: 100%;
    max-height: calc(100dvh - 128px);
    width: auto;
    height: auto;
    border-radius: var(--radius);
    cursor: default;
  }
  .lb-close {
    position: absolute;
    top: 22px;
    right: var(--gutter);
    padding: 6px 0 3px;
    border: 0;
    border-bottom: 1px solid var(--ink);
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox[open],
    .lightbox[open]::backdrop {
      animation: none;
    }
  }
</style>
