---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import HeroWall from '../components/HeroWall.astro';
import Placeholder from '../components/Placeholder.astro';
import { projects, recent } from '../data/site';

const shown = projects.filter((p) => !p.hidden);
// Drafts appear in local preview only, never in the production build.
const features = recent.filter((r) => !r.draft || import.meta.env.DEV);
const half = '(max-width: 700px) 100vw, 400px';

// Hero résumé lines: company, then an optional role (shown in gray italic).
const previous: { company: string; role?: string; href?: string }[] = [
  { company: 'Hank', role: 'Co-founder', href: 'https://www.gethank.com/' },
  { company: 'MLB Advanced Media', href: 'https://www.mlb.com/apps/mlb-app' },
  { company: '1stDibs', href: 'https://www.1stdibs.com/' },
];
---

<Base>
  <section class="hero wrap">
    <h1>
      <span class="ln">I’m <span class="nw">Andrew Hong</span>, a <span class="nw">product designer</span></span>{' '}
      <span class="ln">and repeat founder taking ideas <span class="nw">from zero to shipped.</span></span>
    </h1>
    <p class="cv">
      <span class="label">Current</span>
      <span class="entry"
        ><a class="text-link" href="https://www.classdojo.com" target="_blank" rel="noopener noreferrer">ClassDojo</a
        >{' '}<em>Staff Product Designer</em></span
      >
    </p>
    <p class="cv">
      <span class="label">Previous</span>
      {
        previous.map((p, i) => (
          <>
            {/* The dot rides with the entry before it so it never starts a line. */}
            <span class="entry">
              {p.href ? (
                <a class="text-link" href={p.href} target="_blank" rel="noopener noreferrer">{p.company}</a>
              ) : (
                p.company
              )}
              {p.role && <> <em>{p.role}</em></>}
              {i < previous.length - 1 && <span class="sep" aria-hidden="true">·</span>}
            </span>{' '}
          </>
        ))
      }
    </p>
  </section>

  {
    features.map((r, idx) => (
      <section class="recent">
        <div class="wrap">
          <p class="label">
            {r.company === features[0].company ? 'Recent work' : 'Previously'} · {r.company}
          </p>
          <h2>
            <a class="title-link" href={r.href}>
              {r.heading ? (
                <>{r.heading[0]}<em>{r.heading[1]}</em>{r.heading[2]}</>
              ) : (
                <><em>{r.title}</em> {r.tagline}</>
              )}
            </a>
          </h2>
          <p class="tags">{r.tags}</p>
          <a class:list={['hero-img', { tiles: r.tiles }]} href={r.href} aria-label={`${r.title} case study`}>
            {(r.tiles ?? (r.hero ? [r.hero] : [])).map((img, i) =>
              img.wall ? (
                <HeroWall alt={img.alt} eager={idx === 0} />
              ) : img.video ? (
                <video
                  class="hero-video"
                  src={img.video}
                  poster={img.poster}
                  width="1920"
                  height="1080"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label={img.alt}
                />
              ) : img.name ? (
                <Pic name={img.name} alt={img.alt} sizes={r.tiles ? half : undefined} eager={idx === 0 && i < 2} />
              ) : (
                <Placeholder label={img.alt} />
              ),
            )}
          </a>
          <p class="cta">
            <a class="button" href={r.href}>View case study</a>
          </p>
        </div>
      </section>
    ))
  }

  {
    /* The whole section disappears when every project is hidden. */
    shown.length > 0 && (
      <section class="selected wrap">
        <p class="label">Selected works</p>
        <ul class="grid">
          {
            shown.map((p) => (
              <li>
                <a href={`/project/${p.slug}`}>
                  <Pic name={p.thumb} alt={p.title} sizes={half} />
                  <span class="label years">{p.years}</span>
                  <span class="name">{p.title}</span>
                  <span class="blurb">{p.blurb}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    )
  }
</Base>

<style>
  .hero {
    text-align: center;
    padding-top: clamp(40px, 7vw, 90px);
    padding-bottom: clamp(70px, 10vw, 130px);
  }
  /* Headline: three set lines on wide screens; on narrower ones it wraps
     freely but never splits the phrases marked .nw. */
  .nw {
    white-space: nowrap;
  }
  @media (min-width: 900px) {
    .ln {
      display: block;
    }
  }
  .hero h1 {
    text-wrap: pretty;
    margin: 0 auto 32px;
  }
  .cv {
    font-size: calc(var(--text) * 0.92);
    margin: 0 0 8px;
    /* Split entries evenly across lines instead of leaving one alone. */
    text-wrap: balance;
  }
  .cv .label {
    margin-right: 10px;
  }
  /* Keep "Company Role" together so lines only break between entries. */
  .cv .entry {
    white-space: nowrap;
  }
  .cv em {
    color: var(--muted);
  }
  .cv .sep {
    color: var(--muted);
    margin: 0 0.15em 0 0.45em;
  }

  .recent {
    border-top: 1px solid var(--rule);
    padding: clamp(60px, 8vw, 110px) 0;
    text-align: center;
  }
  .recent h2 {
    margin: 18px auto 14px;
  }
  .recent h2 em {
    font-style: italic;
  }
  .title-link {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.3s ease;
  }
  .title-link:hover {
    background-size: 100% 1px;
  }
  .tags {
    font-style: italic;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .hero-img {
    display: block;
    text-decoration: none;
    margin-top: 48px;
  }
  .hero-img.tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .hero-img :global(img),
  .hero-video,
  .grid :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }
  .cta {
    margin: 48px 0 0;
  }

  .selected {
    border-top: 1px solid var(--rule);
    padding-top: clamp(60px, 8vw, 110px);
  }
  .selected > .label {
    text-align: center;
    margin-bottom: 48px;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px 24px;
  }
  .grid a {
    display: block;
    text-decoration: none;
    text-align: center;
  }
  .grid a :global(img) {
    transition: opacity 0.3s ease;
  }
  .grid a:hover :global(img) {
    opacity: 0.9;
  }
  .name {
    display: block;
    margin-top: 4px;
    font-size: 26px;
    letter-spacing: -0.02em;
  }
  .years {
    display: block;
    margin-top: 20px;
  }
  .blurb {
    display: block;
    font-style: italic;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 700px) {
    .hero-img.tiles,
    .grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .grid {
      gap: 48px;
    }
  }
</style>
