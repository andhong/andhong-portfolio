---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Placeholder from '../components/Placeholder.astro';
import { projects, recent } from '../data/site';

const shown = projects.filter((p) => !p.hidden);
const half = '(max-width: 700px) 100vw, 585px';
---

<Base>
  <section class="hero wrap">
    <h1>A product designer based in Philadelphia making things that I can be proud of.</h1>
    <p class="cv">
      <span class="label">Current</span> Staff Product Designer,{' '}<a
        class="text-link"
        href="https://www.classdojo.com"
        target="_blank"
        rel="noopener noreferrer">ClassDojo</a
      >
    </p>
    <p class="cv">
      <span class="label">Previous</span> Hank (Co-founder; acquired), Lumi (Lead designer; acquired), MLB Advanced
      Media, 1stDibs
    </p>
  </section>

  {
    recent.map((r, idx) => (
      <section class="recent">
        <div class="wrap">
          <p class="label">{idx === 0 ? 'Recent work' : 'Previously'} · {r.company}</p>
          <h2>
            <em>{r.title}</em> {r.tagline}
          </h2>
          <p class="tags">{r.tags}</p>
          <a class="tiles" href={r.href} aria-label={`${r.title} case study`}>
            {r.tiles.map((t, i) =>
              t.name ? (
                <Pic name={t.name} alt={t.alt} sizes={half} eager={idx === 0 && i < 2} />
              ) : (
                <Placeholder label={t.alt} />
              ),
            )}
          </a>
          <p class="cta">
            <a class="more" href={r.href}>View case study ›</a>
          </p>
        </div>
      </section>
    ))
  }

  <section class="selected wrap">
    <p class="label">Selected works</p>
    <ul class="grid">
      {
        shown.map((p) => (
          <li>
            <a href={`/project/${p.slug}`}>
              <Pic name={p.thumb} alt={p.title} sizes={half} />
              <span class="name">{p.title}</span>
              <span class="blurb">{p.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    padding-top: clamp(40px, 7vw, 90px);
    padding-bottom: clamp(70px, 10vw, 130px);
  }
  .hero h1 {
    max-width: 820px;
    margin: 0 auto 32px;
  }
  .cv {
    font-size: 19px;
    margin: 0 0 8px;
  }
  .cv .label {
    margin-right: 6px;
  }

  .recent {
    border-top: 1px solid var(--rule);
    padding: clamp(60px, 8vw, 110px) 0;
    text-align: center;
  }
  .recent h2 {
    max-width: 860px;
    margin: 18px auto 14px;
  }
  .recent h2 em {
    font-style: italic;
  }
  .tags {
    font-style: italic;
    color: var(--muted);
    font-size: 18px;
  }
  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 48px;
  }
  .tiles :global(img),
  .grid :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }
  .cta {
    margin: 48px 0 0;
  }

  .selected {
    border-top: 1px solid var(--rule);
    padding-top: clamp(60px, 8vw, 110px);
  }
  .selected > .label {
    text-align: center;
    margin-bottom: 48px;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px 24px;
  }
  .grid a {
    display: block;
    text-decoration: none;
    text-align: center;
  }
  .grid a :global(img) {
    transition: opacity 0.3s ease;
  }
  .grid a:hover :global(img) {
    opacity: 0.9;
  }
  .name {
    display: block;
    margin-top: 18px;
    font-size: 26px;
    letter-spacing: -0.02em;
  }
  .blurb {
    display: block;
    font-style: italic;
    color: var(--muted);
    font-size: 17px;
  }

  @media (max-width: 700px) {
    .tiles,
    .grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .grid {
      gap: 48px;
    }
  }
</style>
